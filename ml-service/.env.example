DATABASE_URL=postgresql://user:password@localhost:5432/database
# Generate 32 random bytes as 64 hexadecimal characters; use the same value in server/.env.
ML_SERVICE_KEY=
FORECAST_HOST=127.0.0.1
# Hosting: use 0.0.0.0. The platform's PORT overrides FORECAST_PORT.
FORECAST_PORT=8000
# Public hosting liveness probe: /livez. /health requires X-ML-Service-Key.
ML_JOB_TIMEOUT_SECONDS=1800
