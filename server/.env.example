# Copy to .env and fill in. Never commit .env.

# Time — the whole app runs on the Asia/Manila business day (see src/config/time.js).
# DB session is UTC on managed Postgres; business dating is derived explicitly
# via (now() AT TIME ZONE 'Asia/Manila')::date. Pin TZ so host-local clock
# reads (logs, fallbacks, cron wall-clock) also resolve to Manila.
TZ=Asia/Manila
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth — JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=8h

# Database — Supabase pooler for runtime, direct for prisma CLI
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# ML service
FORECAST_URL=http://localhost:8000

# Email (optional — falls back to console log in dev)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASS=
EMAIL_FROM=Abbey's Kitchenette

# Cloudinary (optional — product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (optional — insight text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anomaly Detection cron (default 6am daily)
ANOMALY_CRON_SCHEDULE=0 6 * * *
