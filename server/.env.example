# Copy to .env and fill in. Never commit .env.

# Time — the whole app runs on the Asia/Manila business day (see src/config/time.js).
# DB session is UTC on managed Postgres; business dating is derived explicitly
# via (now() AT TIME ZONE 'Asia/Manila')::date. Pin TZ so host-local clock
# reads (logs, fallbacks, cron wall-clock) also resolve to Manila.
TZ=Asia/Manila
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=
# Production: explicitly set the verified ingress hop count; never trust every proxy.
TRUST_PROXY_HOPS=0
# Same parent domain: strict. Unrelated HTTPS domains: none (browser restrictions still apply).
COOKIE_SAME_SITE=strict
# Production requires postgres. Memory is for local development only.
RATE_LIMIT_STORE=memory
GENERAL_RATE_LIMIT_MAX=500

# Auth — JWT_SECRET must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=8h

# Database — Supabase session pooler for runtime, direct/session connection for CLI.
# Production URLs must use sslmode=verify-full and the provider CA when required.
# Pool size per backend replica; keep the combined total within Supabase limits.
DATABASE_POOL_SIZE=10
DATABASE_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.host.supabase.co:5432/postgres

# Email (optional — falls back to console log in dev)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASS=
EMAIL_FROM=Abbey's Kitchenette
# Production EMAIL_FROM must be a verified sender email address.

# Cloudinary (optional — product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (optional — insight text)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anomaly Detection cron (default 6am daily)
ANOMALY_CRON_SCHEDULE=0 6 * * *

# Realtime (WebSocket on /ws, same port as the API)
# Server pings clients every WS_HEARTBEAT_MS, drops silent sockets.
WS_HEARTBEAT_MS=25000
WS_MAX_CONNECTIONS=256
# Cafe terminals can share one public IP; count browser tabs when sizing this.
WS_MAX_CONNECTIONS_PER_IP=40
WS_MAX_SUBSCRIPTIONS=16
WS_MAX_PAYLOAD_BYTES=8192
WS_MAX_BUFFERED_BYTES=65536
WS_MAX_MESSAGES_PER_10S=40
WS_AUTH_TIMEOUT_MS=5000
# NOTE: WS upgrade requests bypass the HTTP rate limiter (auth-gated
# instead). If served behind a proxy, it must forward Upgrade headers.
# Helmet CSP: allow the WS origin in connect-src when client ≠ API origin.

# Google Sheets live order sync (optional — leave blank to disable).
# Share the sheet with the service-account email as Editor first.
# Private key: single line, literal \n for newlines (no actual line breaks).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SHEETS_ORDERS_ID=

# Backend-only ML connection. Share a random 64-character hex key with ml-service/.env.
FORECAST_URL=http://127.0.0.1:8000
ML_SERVICE_KEY=
ML_REQUEST_TIMEOUT_MS=10000

# Used only by the explicit demo seed CLI; choose your own password (12+ characters).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
