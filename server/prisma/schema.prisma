// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  role              Role      @default(cashier)
  passwordHash      String
  pinHash           String?
  isActive          Boolean   @default(true)
  mustChangePwd     Boolean   @default(false)
  failedPinAttempts Int       @default(0)
  lastFailedPinAt   DateTime?
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  restockBatches    RestockBatch[]
  lossRecords       LossRecord[]
  stockAdjustments  StockAdjustment[]
  createdOrders     Order[]          @relation("OrderCreator")
  acceptedOrders    Order[]          @relation("OrderAcceptedBy")
  nextInlinedOrders Order[]          @relation("OrderNextInLineBy")
  processingOrders  Order[]          @relation("OrderProcessingBy")
  completedOrders   Order[]          @relation("OrderCompletedBy")
  cancelledCancellations OrderCancellation[] @relation("OrderCancelledBy")
}

model SystemSettings {
  id               Int      @id @default(1)
  storeName        String   @default("Abbey's Kitchenette")
  storeAddress     String?
  storePhone       String?
  storeEmail       String?
  storeIpWhitelist String?
  currency         String   @default("PHP")
  taxRate          Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Role {
  admin
  cashier
  kitchen
}

// ── Categories ────────────────────────────────────────────────
model Category {
  categoryId   Int       @id @default(autoincrement()) @map("category_id")
  categoryName String    @unique @map("category_name") @db.VarChar(100)
  description  String?   @db.VarChar(500)
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// ── Products ──────────────────────────────────────────────────
model Product {
  productId   String   @id @default(uuid()) @map("product_id") @db.Uuid
  categoryId  Int      @map("category_id")
  productName String   @map("product_name") @db.VarChar(150)
  description String?  @db.VarChar(500)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [categoryId])

  variants ProductVariant[]
  orderItems OrderItem[]

  @@map("products")
}

// ── Product Variants (sizes with different prices) ────────────
model ProductVariant {
  variantId   Int      @id @default(autoincrement()) @map("variant_id")
  productId   String   @map("product_id") @db.Uuid
  sizeName    String   @map("size_name") @db.VarChar(50)
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")

  product  Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)
  recipes  Recipe[]
  orderItems OrderItem[]
  priceOptimizations PriceOptimization[]

  @@unique([productId, sizeName])
  @@map("product_variants")
}

// ── Ingredients ───────────────────────────────────────────────
model Ingredient {
  ingredientId     String   @id @default(uuid()) @map("ingredient_id") @db.Uuid
  ingredientName   String   @unique @map("ingredient_name") @db.VarChar(150)
  unit             String   @db.VarChar(50)
  minimumThreshold Decimal  @default(0) @map("minimum_threshold") @db.Decimal(10, 3)
  isArchived       Boolean  @default(false) @map("is_archived")
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  recipes            Recipe[]
  restockBatches     RestockBatch[]
  lossRecords        LossRecord[]
  stockAdjustments   StockAdjustment[]
  stockAlerts        StockAlert[]
  orderDeductions    OrderIngredientDeduction[]
  reorderSuggestions ReorderSuggestion[]
  wasteReductions    WasteReduction[]

  @@map("ingredients")
}

// ── Recipe (ingredients per variant) ──────────────────────────
model Recipe {
  recipeId       Int     @id @default(autoincrement()) @map("recipe_id")
  variantId      Int     @map("variant_id")
  ingredientId   String  @map("ingredient_id") @db.Uuid
  quantityNeeded Decimal @map("quantity_needed") @db.Decimal(10, 3)

  variant    ProductVariant @relation(fields: [variantId], references: [variantId], onDelete: Cascade)
  ingredient Ingredient     @relation(fields: [ingredientId], references: [ingredientId])

  @@unique([variantId, ingredientId])
  @@map("recipes")
}

// ── Restock Batches ──────────────────────────────────────────
model RestockBatch {
  restockId      Int      @id @default(autoincrement()) @map("restock_id")
  ingredientId   String   @map("ingredient_id") @db.Uuid
  restockedById  String   @map("restocked_by") @db.Uuid
  quantityAdded  Decimal  @map("quantity_added") @db.Decimal(10, 3)
  quantityLeft   Decimal  @map("quantity_left") @db.Decimal(10, 3)
  costPerUnit    Decimal  @map("cost_per_unit") @db.Decimal(10, 4)
  totalCost      Decimal  @map("total_cost") @db.Decimal(10, 2)
  isPriority     Boolean  @default(false) @map("is_priority")
  version        Int      @default(0)
  supplierName   String?  @map("supplier_name") @db.VarChar(150)
  notes          String?  @db.VarChar(500)
  restockedAt    DateTime @default(now()) @map("restocked_at")

  ingredient   Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)
  restockedBy  User       @relation(fields: [restockedById], references: [id])
  orderDeductions OrderIngredientDeduction[]

  @@map("restock_batches")
}

// ── Loss Records ─────────────────────────────────────────────
model LossRecord {
  lossId           Int      @id @default(autoincrement()) @map("loss_id")
  ingredientId     String   @map("ingredient_id") @db.Uuid
  declaredById     String   @map("declared_by") @db.Uuid
  lossType         LossType @map("loss_type")
  quantityLost     Decimal  @map("quantity_lost") @db.Decimal(10, 3)
  costPerUnit      Decimal  @map("cost_per_unit") @db.Decimal(10, 4)
  totalCostLost    Decimal  @map("total_cost_lost") @db.Decimal(10, 2)
  relatedRestockId Int?     @map("related_restock_id")
  notes            String?  @db.VarChar(500)
  loggedAt         DateTime @default(now()) @map("logged_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)
  declaredBy User       @relation(fields: [declaredById], references: [id])

  @@map("loss_records")
}

// ── Stock Adjustments (audit trail) ──────────────────────────
model StockAdjustment {
  adjustmentId     Int            @id @default(autoincrement()) @map("adjustment_id")
  ingredientId     String         @map("ingredient_id") @db.Uuid
  adjustedById     String         @map("adjusted_by") @db.Uuid
  adjustmentType   AdjustmentType @map("adjustment_type")
  quantityBefore   Decimal        @map("quantity_before") @db.Decimal(10, 3)
  quantityChanged  Decimal        @map("quantity_changed") @db.Decimal(10, 3)
  quantityAfter    Decimal        @map("quantity_after") @db.Decimal(10, 3)
  relatedOrderId   String?        @map("related_order_id") @db.Uuid
  relatedRestockId Int?           @map("related_restock_id")
  relatedLossId    Int?           @map("related_loss_id")
  notes            String?        @db.VarChar(500)
  adjustedAt       DateTime       @default(now()) @map("adjusted_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)
  adjustedBy User       @relation(fields: [adjustedById], references: [id])

  @@map("stock_adjustments")
}

// ── Stock Alerts ─────────────────────────────────────────────
model StockAlert {
  alertId        Int       @id @default(autoincrement()) @map("alert_id")
  ingredientId   String    @map("ingredient_id") @db.Uuid
  alertType      AlertType @map("alert_type")
  stockAtTrigger Decimal   @map("stock_at_trigger") @db.Decimal(10, 3)
  isResolved     Boolean   @default(false) @map("is_resolved")
  resolvedAt     DateTime? @map("resolved_at")
  triggeredAt    DateTime  @default(now()) @map("triggered_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)

  @@map("stock_alerts")
}

// ── Enums ─────────────────────────────────────────────────────
enum LossType {
  spoilage
  spillage
  expiry
  other

  @@map("loss_type_enum")
}

enum AdjustmentType {
  deduction
  restock
  loss
  manual

  @@map("adjustment_type_enum")
}

enum AlertType {
  low_stock
  out_of_stock

  @@map("alert_type_enum")
}

// ── Orders ────────────────────────────────────────────────

enum OrderSource {
  walk_in
  online

  @@map("order_source_enum")
}

enum OrderStatus {
  pending
  accepted
  next_in_line
  processing
  completed
  cancelled

  @@map("order_status_enum")
}

// Auto-incrementing order number per day
model OrderCounter {
  date    DateTime @id @db.Date
  counter Int      @default(0)

  @@map("order_counters")
}

model Order {
  orderId       String      @id @default(uuid()) @map("order_id") @db.Uuid
  orderNumber   Int         @map("order_number")
  orderDate     DateTime    @map("order_date") @db.Date
  customerName  String      @map("customer_name") @db.VarChar(100)
  tableNumber   String      @map("table_number") @db.VarChar(20)
  orderSource   OrderSource @map("order_source")
  status        OrderStatus @default(pending) @map("status")

  // Status timestamps + actors
  acceptedAt      DateTime?   @map("accepted_at") @db.Timestamptz
  acceptedBy      String?     @map("accepted_by") @db.Uuid
  nextInLineAt    DateTime?   @map("next_in_line_at") @db.Timestamptz
  nextInLineBy    String?     @map("next_in_line_by") @db.Uuid
  processingAt    DateTime?   @map("processing_at") @db.Timestamptz
  processingBy    String?     @map("processing_by") @db.Uuid
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz
  completedBy     String?     @map("completed_by") @db.Uuid

  // Payment
  totalAmount   Decimal     @default(0) @map("total_amount") @db.Decimal(10, 2)
  amountPaid    Decimal?    @map("amount_paid") @db.Decimal(10, 2)
  change        Decimal?    @db.Decimal(10, 2)

  // Guest tracking (online orders)
  guestToken    String?     @unique @map("guest_token") @db.Uuid

  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String      @map("created_by") @db.Uuid

  // Relations
  creator         User        @relation("OrderCreator", fields: [createdBy], references: [id])
  acceptedByUser  User?       @relation("OrderAcceptedBy", fields: [acceptedBy], references: [id])
  nextInLineByUser User?      @relation("OrderNextInLineBy", fields: [nextInLineBy], references: [id])
  processingByUser User?      @relation("OrderProcessingBy", fields: [processingBy], references: [id])
  completedByUser  User?      @relation("OrderCompletedBy", fields: [completedBy], references: [id])

  items         OrderItem[]
  cancellation  OrderCancellation?
  deductions    OrderIngredientDeduction[]
  receipt       Receipt?

  @@index([status])
  @@index([orderDate])
  @@index([createdBy])
  @@map("orders")
}

model OrderItem {
  orderItemId  Int      @id @default(autoincrement()) @map("order_item_id")
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    Int      @map("variant_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal? @db.Decimal(10, 2)

  order    Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [productId])
  variant  ProductVariant  @relation(fields: [variantId], references: [variantId])

  @@map("order_items")
}

model OrderCancellation {
  cancellationId Int      @id @default(autoincrement()) @map("cancellation_id")
  orderId        String   @unique @map("order_id") @db.Uuid
  cancelledBy    String   @map("cancelled_by") @db.Uuid
  reason         String?
  cancelledAt    DateTime @default(now()) @map("cancelled_at") @db.Timestamptz

  order          Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  cancelledByUser User    @relation("OrderCancelledBy", fields: [cancelledBy], references: [id])

  @@map("order_cancellations")
}

model OrderIngredientDeduction {
  id               Int       @id @default(autoincrement()) @map("id")
  orderId          String    @map("order_id") @db.Uuid
  ingredientId     String    @map("ingredient_id") @db.Uuid
  restockBatchId   Int       @map("restock_batch_id")
  quantityDeducted Decimal   @map("quantity_deducted") @db.Decimal(10, 3)
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz
  reversedBy       String?   @map("reversed_by") @db.Uuid

  order      Order        @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [ingredientId])
  batch      RestockBatch @relation(fields: [restockBatchId], references: [restockId])

  @@index([orderId])
  @@index([ingredientId])
  @@map("order_ingredient_deductions")
}

model Receipt {
  receiptId   String   @id @default(uuid()) @map("receipt_id") @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  issuedBy    String?  @map("issued_by") @db.Uuid
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz

  order  Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("receipts")
}

// ── Forecasting ──────────────────────────────────────────────
model ForecastJob {
  id            Int       @id @default(autoincrement()) @map("id")
  status        String    @default("running") @db.VarChar(20) // running | completed | failed
  totalVariants Int       @default(0) @map("total_variants")
  completed     Int       @default(0)
  failed        Int       @default(0)
  failedSkips   String[]  @default([]) @map("failed_skips")
  period        Int       @default(14)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  errorMessage  String?   @map("error_message") @db.VarChar(500)

  results ForecastResult[]

  @@map("forecast_jobs")
}

model ForecastResult {
  id          Int     @id @default(autoincrement()) @map("id")
  jobId       Int     @map("job_id")
  variantId   Int     @map("variant_id")
  productName String  @map("product_name") @db.VarChar(150)
  sizeName    String  @map("size_name") @db.VarChar(50)
  price       Decimal @db.Decimal(10, 2)
  categoryId  Int     @map("category_id")
  dailyData   Json    @map("daily_data")
  totalUnits  Int     @default(0) @map("total_units")
  totalRevenue Float  @default(0) @map("total_revenue")
  trend       String  @default("stable") @db.VarChar(20)
  daysOfData  Int     @default(0) @map("days_of_data")
  skipped     Boolean @default(false)
  skipReason  String? @map("skip_reason") @db.VarChar(200)

  job ForecastJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, variantId])
  @@map("forecast_results")
}

// ── Intelligence: Reorder Suggestions ────────────────────────
model ReorderSuggestion {
  id                String    @id @default(uuid()) @db.Uuid
  ingredientId      String    @map("ingredient_id") @db.Uuid
  currentStock      Decimal   @map("current_stock") @db.Decimal(10, 3)
  unit              String    @db.VarChar(50)
  suggestedQuantity Decimal   @map("suggested_quantity") @db.Decimal(10, 3)
  urgency           String    @db.VarChar(20) // high | medium | low
  reasoning         String    @db.Text
  estimatedStockout DateTime? @map("estimated_stockout")
  confidence        Float
  status            String    @default("pending") @db.VarChar(20) // pending | accepted | rejected
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)

  @@index([status])
  @@index([ingredientId])
  @@map("reorder_suggestions")
}

// ── Intelligence: Waste Reduction ────────────────────────────
model WasteReduction {
  id              String    @id @default(uuid()) @db.Uuid
  ingredientId    String    @map("ingredient_id") @db.Uuid
  currentStock    Decimal   @map("current_stock") @db.Decimal(10, 3)
  forecastedUsage Decimal   @map("forecasted_usage") @db.Decimal(10, 3)
  unit            String    @db.VarChar(50)
  overstockAmount Decimal   @map("overstock_amount") @db.Decimal(10, 3)
  wasteRisk       String    @db.VarChar(20) // high | medium | low
  reasoning       String    @db.Text
  suggestion      String    @db.Text
  potentialSavings Decimal? @map("potential_savings") @db.Decimal(10, 2)
  confidence      Float
  status          String    @default("pending") @db.VarChar(20) // pending | accepted | rejected
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)

  @@index([status])
  @@index([ingredientId])
  @@map("waste_reductions")
}

// ── Price Optimization ─────────────────────────────────────
model PriceOptimization {
  id               Int      @id @default(autoincrement())
  variantId        Int      @map("variant_id")
  productName      String   @map("product_name") @db.VarChar(150)
  sizeName         String   @map("size_name") @db.VarChar(50)
  currentPrice     Decimal  @map("current_price") @db.Decimal(10, 2)
  recommendedPrice Decimal  @map("recommended_price") @db.Decimal(10, 2)
  priceChange      Decimal  @map("price_change") @db.Decimal(10, 2)
  changePercent    Float    @map("change_percent")
  direction        String   @db.VarChar(10) // increase | decrease | keep
  confidence       Float
  reasoning        String   @db.Text
  marginBefore     Float    @map("margin_before")
  marginAfter      Float    @map("margin_after")
  competitorAvg    Float?   @map("competitor_avg")
  status           String   @default("pending") @db.VarChar(20) // pending | accepted | rejected
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [variantId], onDelete: Cascade)

  @@index([status])
  @@index([variantId])
  @@map("price_optimizations")
}