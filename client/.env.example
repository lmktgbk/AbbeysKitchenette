# Client env (copy to .env and override per environment).
# WHY VITE_ prefix: Vite only exposes VITE_* vars to the browser via import.meta.env.
# VITE_API_URL must point at the API base (dev proxy in vite.config.js is dev-only).
VITE_API_URL=http://localhost:5000/api
# Optional override. Otherwise /ws is derived from VITE_API_URL, including wss for HTTPS.
VITE_WS_URL=
VITE_REALTIME=on
# Vercel production: VITE_API_URL=/api, direct Railway VITE_WS_URL, VITE_WS_TICKET=on.
VITE_WS_TICKET=off
# Server-only Vercel Function variables (never prefix these with VITE_):
# API_UPSTREAM_ORIGIN=https://abbeyskitchenette-production.up.railway.app
# API_PROXY_SECRET=<same random 64-character secret as Railway>
